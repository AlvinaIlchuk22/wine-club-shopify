<section class="sec" {{ section.shopify_attributes }}>
  <div class="wrap" style="max-width:820px">
    <div class="reveal" style="margin-bottom:30px"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading_start }} <em>{{ section.settings.heading_em }}</em></h2></div>
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><p>{{ block.settings.answer }}</p></details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Questions",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading_start",
      "label": "Heading (start)",
      "default": "Good to"
    },
    {
      "type": "text",
      "id": "heading_em",
      "label": "Heading (italic)",
      "default": "know"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Can I skip or pause a shipment?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Yes. Skip any release with one click up to 7 days before it ships, or pause the club for as long as you like. No fees, no questions."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question",
          "settings": {
            "question": "How much is shipping?",
            "answer": "Free on every Cellar Circle shipment Australia-wide. Standard shipping applies to extra orders."
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do I need to be home to receive wine?",
            "answer": "An adult must sign. Choose a work address, a neighbour or hold at the cellar door."
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What if I do not like a wine?",
            "answer": "Tell us within 30 days and we will replace it or credit your account."
          }
        }
      ]
    }
  ]
}
{% endschema %}
