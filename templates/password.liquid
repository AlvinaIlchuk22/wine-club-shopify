<section class="page-wrap">
  <div class="wrap" style="text-align:center">
    <span class="eyebrow">{{ shop.name }}</span>
    <h1>Opening <em>soon</em></h1>
    <p class="lede" style="margin:0 auto 26px">{{ shop.password_message | default: 'This store is not open to the public yet.' }}</p>
    {% form 'storefront_password', class: 'uform', style: 'margin:0 auto' %}
      {{ form.errors | default_errors }}
      <label for="Password">Password</label>
      <input type="password" name="password" id="Password" autocomplete="current-password">
      <button class="btn solid" type="submit">Enter</button>
    {% endform %}
  </div>
</section>
